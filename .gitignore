# Python
__pycache__/
*.pyc
.venv/
env/

# Secrets (cles API, identifiants)
.env

# Donnees brutes et traitees (regenerees par download_data.py) : garder les dossiers, ignorer leur contenu
data/raw/*
!data/raw/.gitkeep
data/processed/*
!data/processed/.gitkeep

# Fichiers volumineux ou binaires (garder de petits echantillons au besoin)
*.tif
*.zip
*.gpkg
*.graphml

# Journaux d'execution du pipeline
logs/
*.log

# Tests et couverture
.pytest_cache/
.coverage
coverage.xml

# Systeme et editeur
.DS_Store
.ipynb_checkpoints/
.vscode/

# Cartes interactives volumineuses (regenerees par main.py)
outputs/maps/*.html

# Cache des requetes OSMnx vers l'API Overpass (regenerable)
cache/
