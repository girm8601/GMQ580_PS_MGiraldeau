# Caches Python et outils (regeneres a chaque execution de python, pytest ou ruff)
__pycache__/
*.pyc
.pytest_cache/
.ruff_cache/
.coverage
coverage.xml

# Donnees brutes et traitees (regenerees par download_data.py) : garder les dossiers, ignorer leur contenu
data/raw/*
!data/raw/.gitkeep
data/processed/*
!data/processed/.gitkeep

# Couches spatiales volumineuses (au cas ou une couche serait ecrite hors de data/)
*.gpkg
*.graphml

# Journaux d'execution du pipeline
logs/
*.log

# Cartes interactives volumineuses (regenerees par main.py)
outputs/maps/*.html

# Cache des requetes OSMnx vers l'API Overpass (regenerable)
cache/

# Reglages personnels de l'editeur et fichiers systeme Windows
.vscode/
Thumbs.db
